[
  {
    "env_name": "INPUT_CONNECTOR_TOPIC",
    "variable_type": "Input Topic",
    "mandatory": true,
    "default_value": "raw-orders"
  },
  {
    "env_name": "OUTPUT_CONNECTOR_TOPIC",
    "variable_type": "Output Topic",
    "mandatory": true,
    "default_value": "processed-orders"
  },
  {
    "env_name": "KAFKA_BOOTSTRAP_SERVERS",
    "variable_type": "String",
    "mandatory": true,
    "default_value": "localhost:9092"
  },
  {
    "env_name": "KAFKA_SASL_USERNAME",
    "variable_type": "String",
    "mandatory": true,
    "default_value": "your_sasl_username"
  },
  {
    "env_name": "KAFKA_SASL_PASSWORD",
    "variable_type": "Password",
    "mandatory": true,
    "default_value": "your_sasl_password"
  }
]
